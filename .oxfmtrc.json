{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    "native/**",
    "node_modules/**",
    "work/**",
    "outputs/**",
    "benchmark-results/**",
    "package-lock.json"
  ]
}
